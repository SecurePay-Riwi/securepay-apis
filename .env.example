# AWS. En local va a LocalStack; en AWS, AWS_ENDPOINT_URL no se pone y las
# credenciales salen del rol. LocalStack acepta cualquier credencial.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Servicio simulado de listas restrictivas (proveedor externo, puerto 8001)
# file: lee el archivo que exporta el seed. s3: lee el bucket del proveedor.
LISTA_SOURCE=file
LISTA_LATENCIA_MIN_MS=50
LISTA_LATENCIA_MAX_MS=3000
LISTA_FALLA_PCT=5
# LISTA_SEMILLA=42
# Si no se define, se busca en generated/listas/ y en
# ../securepay-seed/generated/listas/ (el repo del seed clonado al lado).
# SEED_LIST_FILE=generated/listas/lista_restrictiva.jsonl
PROVEEDOR_LISTAS_BUCKET=pagoseguro-proveedor-listas
# PROVEEDOR_LISTAS_KEY=lista_restrictiva.jsonl

# Tasas de cambio (Frankfurter)
# file: un JSON por día en src/securepay_apis/exchange_rates/data/ (solo
# necesita internet). dynamodb: la tabla de tasas (LocalStack en local; la
# crea infra/localstack/init/03_exchange_rates.py del repo SecurePay).
RATES_OUTPUT=file
RATES_TABLE=pagoseguro-exchange-rates
# Sin definir: solo las tasas de hoy, como la Lambda diaria. Con una fecha:
# todos los días publicados desde esa fecha hasta hoy (para que el motor
# tenga las tasas de las transacciones simuladas desde la fecha de referencia).
# RATES_FROM=2026-10-01
